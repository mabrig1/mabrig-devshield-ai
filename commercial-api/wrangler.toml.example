name = "devshield-commercial-api"
main = "worker/src/index.mjs"
compatibility_date = "2026-10-01"
workers_dev = false

# Add a custom domain only after DNS ownership and production checks.
# routes = [{ pattern = "api.devshield.mabrigkorie.org", custom_domain = true }]

[[d1_databases]]
binding = "DB"
database_name = "devshield-commercial"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"

[observability]
enabled = true
