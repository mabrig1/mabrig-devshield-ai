name = "devshield-runtime-waf"
main = "worker/src/index.js"
compatibility_date = "2026-10-01"
compatibility_flags = ["nodejs_compat"]

[vars]
WAF_MODE = "observe"
WAF_BLOCK_SCORE = "70"
WAF_ALLOWED_ORIGINS = ""
UPSTREAM_ORIGIN = "https://REPLACE-WITH-UPSTREAM.example.com"

# Optional persistent best-effort rate limiting:
# [[kv_namespaces]]
# binding = "RATE_KV"
# id = "REPLACE_WITH_KV_NAMESPACE_ID"
