{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "mabrig-devshield-ai",
  "main": "cloudflare-deploy/src/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./cloudflare-deploy/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {}
}
