{
  "name": "mabrig-devshield-ai-action",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "devshield": "bin/devshield.mjs",
    "devshield-remediate": "bin/remediate.mjs",
    "devshield-inventory": "bin/inventory.mjs",
    "devshield-runtime": "bin/runtime-guard.mjs",
    "devshield-legal": "bin/legal-scan.mjs",
    "devshield-api-trust": "bin/api-trust.mjs",
    "devshield-waap-policy": "bin/waap-policy.mjs"
  },
  "scripts": {
    "test": "bash test/smoke.sh",
    "scan": "node bin/devshield.mjs",
    "remediate": "node bin/remediate.mjs",
    "inventory": "node bin/inventory.mjs",
    "runtime": "node bin/runtime-guard.mjs",
    "control-boundary": "node examples/human-control-boundary.mjs",
    "legal": "node bin/legal-scan.mjs",
    "api-trust": "node bin/api-trust.mjs",
    "waf:test": "node --test test/runtime-waf.test.mjs",
    "waap:test": "node --test test/waap.test.mjs test/waap-openapi.test.mjs test/waap-worker.test.mjs",
    "waap:policy": "node bin/waap-policy.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
